<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.so7o.ztrackpad.lite"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="So7o Z Trackpad Lite"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="So7o Z Trackpad Lite">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TrackpadService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:description="@string/accessibility_service_description">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Scriptable pad control, so the pad's own state can be read and the lock driven
             without tapping. See tests/smoke.sh for the invocation. -->
        <receiver
            android:name=".ControlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.so7o.ztrackpad.lite.CONTROL" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
